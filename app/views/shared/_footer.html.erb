<footer class="footer">
  <div class="container footer__grid">

    <!-- Identité -->
    <div class="footer__brand">
      <div class="footer__brandTop">
        <img
          src="<%= asset_path('logo-la-table-du-chef.webp') %>"
          alt="La Table du Chef"
          class="footer__brandLogo"
          width="90"
          height="90"
          loading="lazy"
          decoding="async"
        />

        <div class="footer__brandText">
          <h2 class="footer__title">La Table du Chef</h2>
          <p class="footer__subtitle">Bistronomie • Saison • Nancy</p>
        </div>
      </div>

      <p class="footer__address">
        12 rue Imaginaire<br>
        54000 Nancy
      </p>

      <p class="footer__contact">
        <a href="mailto:latableduchef@example.com">latableduchef@example.com</a><br>
        <a href="tel:0123456789">01 23 45 67 89</a>
      </p>
    </div>

    <!-- Navigation site -->
    <nav class="footer__nav" aria-label="Navigation du site">
      <a href="<%= root_path %>">Accueil</a>
      <a href="<%= menu_path %>">Menu</a>
      <a href="<%= reservation_path %>">Réserver</a>
      <a href="<%= contact_path %>">Contact</a>
    </nav>

    <!-- Liens légaux -->
    <nav class="footer__legal" aria-label="Informations légales">
      <a href="<%= mentions_legales_path %>">Mentions légales</a>
      <a href="<%= politique_confidentialite_path %>">Politique de confidentialité</a>
      <a href="<%= cookies_path %>">Gestion des cookies</a>
    </nav>

    <!-- Réseaux sociaux -->
    <div class="footer__socials" aria-label="Réseaux sociaux">
      <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
      <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
      <a href="#" aria-label="X / Twitter"><i class="fab fa-x-twitter"></i></a>
    </div>

  </div>

  <!-- Bottom -->
  <div class="footer__bottom">
    <div class="container footer__bottomInner">
      <div class="footer__copyright">
        © <%= Time.current.year %> La Table du Chef — Tous droits réservés
      </div>

      <a class="footer__credit" href="https://www.titouweb.com" target="_blank" rel="noopener">
        <span>Site développé par Titouweb</span>
        <img
          src="<%= asset_path('logo-titouweb.png') %>"
          alt="TitouWeb"
          class="footer__creditLogo"
          width="92"
          height="26"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</footer>
