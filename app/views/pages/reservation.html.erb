<div class="reservation-page">
  <div class="reservation-page__wrap">
    <div class="rs-card">

      <div class="rs-head">
        <h1 class="rs-title">Réserver une table</h1>
        <p class="rs-subtitle">
          Réservation recommandée — réponse rapide par e-mail.
        </p>
      </div>

      <%= form_with model: @reservation,
                    url: create_reservation_path,
                    data: { turbo: true },
                    class: "rs-form" do |f| %>

        <!-- ✅ Le controller est ici (wrapper) pour que step2/summary soient bien trouvés -->
        <div class="rs-grid"
             data-controller="reservation-datepicker"
             data-reservation-datepicker-max-days-value="21"
             data-reservation-datepicker-open-on-connect-value="true">

          <!-- =========================
               STEP 1 — DATE & TIME
               ========================= -->
          <div class="rs-field rs-field--full">

            <label class="rs-label" for="reservation_date_display">
              Date & heure
            </label>

            <!-- Résumé (affiché après choix) -->
            <div class="rs-summary" data-reservation-datepicker-target="summary" hidden>
              <span class="rs-summary__text" data-reservation-datepicker-target="summaryText"></span>
              <button type="button"
                      class="rs-summary__edit"
                      data-action="reservation-datepicker#edit">
                Modifier
              </button>
            </div>

            <!-- Input display (facultatif) -->
            <input
              id="reservation_date_display"
              type="text"
              class="rs-input"
              placeholder="Sélectionnez une date puis une heure"
              autocomplete="off"
              readonly
              data-reservation-datepicker-target="display"
            />

            <!-- Hidden field réellement envoyé -->
            <%= f.hidden_field :date,
                  id: "reservation_date",
                  data: { reservation_datepicker_target: "hidden" } %>

            <!-- Calendrier INLINE (visible au début) -->
            <div class="rs-cal rs-cal--inline"
                 data-reservation-datepicker-target="popover"
                 role="region"
                 aria-label="Calendrier de réservation">

              <div class="rs-cal__head">
                <button type="button"
                        class="rs-cal__nav"
                        data-action="reservation-datepicker#prevMonth"
                        aria-label="Mois précédent">‹</button>

                <div class="rs-cal__title" data-reservation-datepicker-target="title"></div>

                <button type="button"
                        class="rs-cal__nav"
                        data-action="reservation-datepicker#nextMonth"
                        aria-label="Mois suivant">›</button>
              </div>

              <div class="rs-cal__dow" aria-hidden="true">
                <span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span>
              </div>

              <div class="rs-cal__grid"
                   role="grid"
                   data-reservation-datepicker-target="days"></div>

              <div class="rs-cal__time">
                <p class="rs-cal__timeLabel">Heure</p>
                <div class="rs-cal__slots" data-reservation-datepicker-target="slots"></div>
                <p class="rs-cal__hint">Créneaux disponibles sur les 21 prochains jours.</p>
              </div>

              <div class="rs-cal__actions">
                <button type="button"
                        class="rs-cal__btn rs-cal__btn--ghost"
                        data-action="reservation-datepicker#clear">
                  Effacer
                </button>

                <button type="button"
                        class="rs-cal__btn rs-cal__btn--primary"
                        data-action="reservation-datepicker#pickToday">
                  Aujourd’hui
                </button>
              </div>

            </div>
          </div>

          <!-- =========================
               STEP 2 — FORM (hidden until date+time selected)
               ========================= -->
          <div class="rs-step2"
               data-reservation-datepicker-target="step2"
               hidden>

            <div class="rs-stepTitle">
              <h2 class="rs-stepTitle__h">Vos informations</h2>
              <p class="rs-stepTitle__p">Renseignez vos coordonnées pour confirmer la demande.</p>
            </div>

            <div class="rs-stepGrid">

              <div class="rs-field">
                <%= f.label :name, "Nom", class: "rs-label" %>
                <%= f.text_field :name,
                      class: "rs-input",
                      placeholder: "Votre nom" %>
              </div>

              <div class="rs-field">
                <%= f.label :email, "Email", class: "rs-label" %>
                <%= f.email_field :email,
                      class: "rs-input",
                      placeholder: "nom@domaine.fr" %>
              </div>

              <div class="rs-field">
                <%= f.label :phone, "Téléphone", class: "rs-label" %>
                <%= f.telephone_field :phone,
                      class: "rs-input",
                      placeholder: "06 00 00 00 00" %>
              </div>

              <div class="rs-field">
                <%= f.label :number_of_guests, "Nombre de convives", class: "rs-label" %>
                <%= f.number_field :number_of_guests,
                      class: "rs-input",
                      min: 1,
                      max: 12,
                      placeholder: "2" %>
                <p class="rs-hint">
                  Pour plus de 12 personnes, contactez-nous directement.
                </p>
              </div>

            </div>

            <div class="rs-actions">
              <%= f.submit "Réserver", class: "rs-btn rs-btn--primary rs-btn--wide" %>
              <p class="rs-note">
                En validant, vous acceptez d’être recontacté pour confirmation.
              </p>
            </div>

          </div>

        </div>

      <% end %>
    </div>
  </div>
</div>
