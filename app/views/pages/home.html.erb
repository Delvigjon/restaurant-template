<section class="section section--story">
  <div class="container grid-2">
    <div class="story__media">
      <img src="<%= asset_path('chef.webp') %>" alt="Le chef en cuisine" loading="lazy">
    </div>

    <div class="story__content">
      <p class="eyebrow">Notre histoire</p>
      <h2 class="h2">Une cuisine de saison, un geste précis</h2>
      <p class="p">
        Depuis 2015, nous cuisinons une bistronomie moderne : produits frais, sauces nettes,
        cuissons maîtrisées, et une carte qui change régulièrement.
      </p>
      <p class="p">
        Ici, l’expérience compte autant que l’assiette : accueil, rythme du service, accords mets & vins.
      </p>

      <a class="text-link" href="<%= menu_path %>">Voir la carte →</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Galerie</p>
      <h2 class="h2">L’ambiance & quelques assiettes</h2>
      <p class="p p--muted">Cuisine, salle, boissons — un aperçu de l’expérience.</p>
    </div>

    <div class="gallery">
      <a class="gallery__item gallery__item--wide" href="<%= asset_path('restaurant.webp') %>">
        <img src="<%= asset_path('restaurant.webp') %>" alt="Ambiance du restaurant" loading="lazy">
      </a>

      <a class="gallery__item" href="<%= asset_path('restaurant-dish-signature-1.webp') %>">
        <img src="<%= asset_path('restaurant-dish-signature-1.webp') %>" alt="Plat signature" loading="lazy">
      </a>

      <a class="gallery__item" href="<%= asset_path('restaurant-dish-signature-2.webp') %>">
        <img src="<%= asset_path('restaurant-dish-signature-2.webp') %>" alt="Plat signature" loading="lazy">
      </a>

      <a class="gallery__item" href="<%= asset_path('restaurant-wine-cellar.webp') %>">
        <img src="<%= asset_path('restaurant-wine-cellar.webp') %>" alt="Cave à vin" loading="lazy">
      </a>

      <a class="gallery__item" href="<%= asset_path('restaurant-cocktail.webp') %>">
        <img src="<%= asset_path('restaurant-cocktail.webp') %>" alt="Cocktail" loading="lazy">
      </a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">La carte</p>
      <h2 class="h2">Quelques signatures</h2>
      <p class="p p--muted">Une sélection qui évolue selon arrivages et saisons.</p>
    </div>

    <div class="cards">
      <article class="dish">
        <h3 class="dish__title">Entrée du moment</h3>
        <p class="dish__desc">Fraîcheur, équilibre, et un twist végétal.</p>
        <p class="dish__meta">À partir de 12€</p>
      </article>

      <article class="dish">
        <h3 class="dish__title">Plat signature</h3>
        <p class="dish__desc">Cuisson juste, sauce courte, accompagnement de saison.</p>
        <p class="dish__meta">À partir de 24€</p>
      </article>

      <article class="dish">
        <h3 class="dish__title">Dessert maison</h3>
        <p class="dish__desc">Gourmandise maîtrisée, sans lourdeur.</p>
        <p class="dish__meta">À partir de 9€</p>
      </article>
    </div>

    <div class="section__cta">
      <a class="btn btn--primary" href="<%= menu_path %>">Voir le menu complet</a>
    </div>
  </div>
</section>
<section class="section section--infos">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Infos pratiques</p>
      <h2 class="h2">Accès & services</h2>
      <p class="p p--muted">Tout ce qu’il faut pour venir l’esprit léger.</p>
    </div>

    <ul class="info-list info-list--rich">
      <li class="info info--rich">
        <span class="info__icon" aria-hidden="true">
          <i class="fa-solid fa-square-parking"></i>
        </span>
        <div class="info__body">
          <span class="info__label">Parking</span>
          <span class="info__value">À proximité immédiate</span>
          <span class="info__hint">Rue / parking public à 2 min à pied.</span>
        </div>
      </li>

      <li class="info info--rich">
        <span class="info__icon" aria-hidden="true">
          <i class="fa-solid fa-wheelchair"></i>
        </span>
        <div class="info__body">
          <span class="info__label">Accessibilité</span>
          <span class="info__value">Accès PMR</span>
          <span class="info__hint">Salle & sanitaires accessibles.</span>
        </div>
      </li>

      <li class="info info--rich">
        <span class="info__icon" aria-hidden="true">
          <i class="fa-solid fa-credit-card"></i>
        </span>
        <div class="info__body">
          <span class="info__label">Paiement</span>
          <span class="info__value">CB, espèces, titres restaurant</span>
          <span class="info__hint">Tickets acceptés le midi.</span>
        </div>
      </li>

      <li class="info info--rich">
        <span class="info__icon" aria-hidden="true">
          <i class="fa-solid fa-clock"></i>
        </span>
        <div class="info__body">
          <span class="info__label">Horaires</span>
          <span class="info__value">Lun–Ven : 12:00–14:00 · Ven : 19:00–22:00</span>
          <span class="info__hint">Fermé le week-end (sur privatisation : nous contacter).</span>
        </div>
      </li>

      <li class="info info--rich">
        <span class="info__icon" aria-hidden="true">
          <i class="fa-solid fa-utensils"></i>
        </span>
        <div class="info__body">
          <span class="info__label">Allergènes</span>
          <span class="info__value">Informations sur demande</span>
          <span class="info__hint">Options végétariennes selon arrivages.</span>
        </div>
      </li>

      <li class="info info--rich">
        <span class="info__icon" aria-hidden="true">
          <i class="fa-solid fa-calendar-check"></i>
        </span>
        <div class="info__body">
          <span class="info__label">Réservation</span>
          <span class="info__value">Conseillée</span>
          <span class="info__hint">Groupes : merci d’anticiper (menu dédié possible).</span>
        </div>
      </li>
    </ul>

    <div class="section__cta">
      <a class="btn btn--primary" href="#reservation">Réserver une table</a>
      <a class="btn btn--ghost" href="tel:0123456789">Appeler</a>
    </div>
  </div>
</section>


<section class="section">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Nous trouver</p>
      <h2 class="h2">Adresse & itinéraire</h2>
      <p class="p p--muted">Réservation recommandée.</p>
    </div>

    <div class="map">
  <iframe
    class="map__iframe"
    src="https://www.google.com/maps?q=Place%20Stanislas%2C%20Nancy&output=embed"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen></iframe>
</div>

<div class="section__cta">
  <a class="btn btn--ghost"
     href="https://www.google.com/maps/dir/?api=1&destination=Place%20Stanislas%2C%20Nancy"
     target="_blank" rel="noopener">
    Obtenir un itinéraire
  </a>
</div>

</section>
